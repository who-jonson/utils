{
  "name": "@whoj/utils",
  "description": "All collection of common JS / TS helpers/utils by @whoj",
  "version": "2.4.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=16.9"
  },
  "keywords": [
    "typescript",
    "ts",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.mjs"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.mjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs"
    },
    "./php": {
      "types": "./dist/php.d.ts",
      "import": "./dist/php.mjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/*",
        "./dist/*.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "prebuild": "tsx scripts/buildhook.ts --pre",
    "stub": "pnpm run prebuild && unbuild --stub",
    "prepublishOnly": "rm -rf dist && pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whoj/utils-core": "workspace:*",
    "@whoj/utils-types": "workspace:*"
  },
  "peerDependencies": {
    "@whoj/utils-php": "workspace:*",
    "@whoj/utils-vue": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@whoj/utils-php": {
      "optional": true
    },
    "@whoj/utils-vue": {
      "optional": true
    }
  },
  "author": {
    "name": "Jonson B.",
    "email": "www.jbc.bd@gmail.com",
    "url": "https://whoj.dev"
  },
  "homepage": "https://github.com/who-jonson/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/who-jonson/utils.git",
    "directory": "packages/all"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bugs": "https://github.com/who-jonson/utils/issues",
  "sideEffects": false
}
